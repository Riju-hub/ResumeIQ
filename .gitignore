# Environment & Secrets (Never commit these)
.env
.env.*
*.env
frontend/.streamlit/secrets.toml

.env
*.env
backend/.env
frontend/.env

# Virtual Environments
venv/
env/
ENV/
.venv/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage

# Datasets & Uploaded Artifacts
*.csv
*.tsv
*.jsonl
*.pdf
*.docx
*.doc
backend/uploads/
backend/temp/
frontend/temp/

# Logs
*.log
logs/

# Machine Learning Models & Checkpoints
*.safetensors
*.pkl
*.pickle
*.pt
*.pth
*.onnx
*.bin
*.h5
models_cache/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini


